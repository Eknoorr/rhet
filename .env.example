# =============================================================================
# parrhet.ai — environment variable template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# =============================================================================
# Microsoft Foundry / Azure AI Projects
# =============================================================================
# Your AI Foundry project endpoint (from Azure AI Foundry portal)
FOUNDRY_PROJECT_ENDPOINT=https://your-project.api.azureml.ms/

# Name of the deployed Rhet agent in Foundry (default: agentllm)
FOUNDRY_AGENT_NAME=agentllm

# =============================================================================
# Azure Cognitive Services — Speech
# =============================================================================
# Key and region from your Azure Speech resource
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# =============================================================================
# Azure AI Language (Text Analytics)
# =============================================================================
AZURE_LANGUAGE_KEY=
AZURE_LANGUAGE_ENDPOINT=https://your-language-resource.cognitiveservices.azure.com/

# =============================================================================
# Azure Translator
# =============================================================================
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com/
AZURE_TRANSLATOR_REGION=eastus

# =============================================================================
# Azure Cosmos DB
# =============================================================================
# Cosmos DB account endpoint (from Azure portal → Keys)
COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/

# Database and container names (defaults shown)
COSMOS_DATABASE=rhet_db
COSMOS_USERS_CONTAINER=users
COSMOS_CONVERSATIONS_CONTAINER=conversations
COSMOS_PROGRESS_CONTAINER=progress

# =============================================================================
# Azure AI Search — Knowledge Base (optional / planned)
# =============================================================================
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX_NAME=language-learning-kb

# =============================================================================
# Azure Application Insights — Observability (optional)
# =============================================================================
# Connection string from your Application Insights resource
APPLICATIONINSIGHTS_CONNECTION_STRING=

# =============================================================================
# Google OAuth (Streamlit built-in auth)
# These values are also required in .streamlit/secrets.toml — see docs/SETUP.md
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The URL Streamlit is served on — must match an Authorised redirect URI in
# Google Cloud Console with the /oauth2callback suffix added by Streamlit
GOOGLE_REDIRECT_URI=http://localhost:8501

# =============================================================================
# Email / OTP delivery
# =============================================================================
# Verified sender address that OTP emails come from
EMAIL_FROM=noreply@parrhet.ai

# How long (seconds) a verification code is valid (default: 600 = 10 min)
OTP_EXPIRY_SECONDS=600

# Option A — SendGrid (preferred)
# Obtain an API key at https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=

# Option B — plain SMTP fallback (used when SENDGRID_API_KEY is blank)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
